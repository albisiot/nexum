rules_version = '2';

// Regole di sicurezza del database Firestore di NEXUM.
// Da incollare in console Firebase → Firestore Database → Regole → Pubblica.
//
// - catalog/published: i dati di gioco pubblicati, leggibili da chiunque.
// - catalog/draft: la bozza dell'Editor.
// Solo l'account dell'Editor (con email verificata da Google) può scrivere.
// - rooms: le stanze del gioco online. Il codice della stanza si legge solo conoscendolo;
//   chi l'ha creata fa da arbitro. Ogni giocatore legge solo la propria vista, quindi non le carte altrui.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email == 'albividal2@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /catalog/published {
      allow read: if true;
      allow write: if isEditor();
    }

    match /catalog/draft {
      allow read, write: if isEditor();
    }

    function roomData(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isArbiter(code) {
      return request.auth != null && roomData(code).hostUid == request.auth.uid;
    }

    function validName(member) {
      return member.name is string && member.name.size() > 0 && member.name.size() <= 40;
    }

    match /rooms/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && code.matches('^[A-Z2-9]{5}$')
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'lobby'
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.members[request.auth.uid]);
      // L'arbitro aggiorna la stanza; gli altri possono solo entrare o uscire, e toccare solo se stessi.
      allow update: if request.auth != null && (
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.code == resource.data.code)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members.size() <= 8
          && (
            !(request.auth.uid in request.resource.data.members)
            || (resource.data.status == 'lobby' && validName(request.resource.data.members[request.auth.uid]))
          ))
      );

      match /views/{uid} {
        allow get: if request.auth != null && request.auth.uid == uid;
        allow write: if isArbiter(code);
      }

      match /actions/{id} {
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in roomData(code).members
          && request.resource.data.action is string
          && request.resource.data.action.size() < 2000;
        allow read, delete: if isArbiter(code);
      }

      match /host/{doc} {
        allow read, write: if isArbiter(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
