rules_version = '2';

// Regole di sicurezza del database Firestore di NEXUM.
// Da incollare in console Firebase → Firestore Database → Regole → Pubblica.
//
// - catalog/published: i dati di gioco pubblicati, leggibili da chiunque.
// - catalog/draft: la bozza dell'Editor.
// Solo l'account dell'Editor (con email verificata da Google) può scrivere.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email == 'albividal2@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /catalog/published {
      allow read: if true;
      allow write: if isEditor();
    }

    match /catalog/draft {
      allow read, write: if isEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
